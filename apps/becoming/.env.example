# Supabase — copy to .env.local and fill in from your Supabase project settings
# (Project Settings -> API). Both values are safe to expose in a client build;
# Row-Level Security is what protects the data. Leave these blank to run the
# app entirely on localStorage (no backend).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
